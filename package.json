{
  "name": "mta-nexus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nexus/web dev",
    "build": "pnpm --filter @nexus/web build",
    "start": "pnpm --filter @nexus/web start",
    "lint": "pnpm --filter @nexus/web lint",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @nexus/db generate",
    "db:migrate": "pnpm --filter @nexus/db migrate",
    "db:seed": "pnpm --filter @nexus/db seed",
    "release:verify": "node scripts/release-evidence.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.4.2"
  },
  "packageManager": "pnpm@12.4.2"
}
