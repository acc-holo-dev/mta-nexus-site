{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    -Server
  }

  # Reject declared oversized bodies even if the upstream never reads them.
  @oversized_body expression `{header.Content-Length} != "" && int({header.Content-Length}) > 68157440`
  respond @oversized_body "Request body too large" 413

  # Keep the streaming limit for chunked requests without Content-Length.
  request_body {
    max_size 68157440
  }
  reverse_proxy app:3000 {
    header_up X-Forwarded-For {remote_host}
    header_up X-Real-IP {remote_host}
    header_up X-Nexus-Proxy-Secret {$TRUSTED_PROXY_SECRET}
  }
}
