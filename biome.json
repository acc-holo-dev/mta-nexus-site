{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true
  },
  "overrides": [
    {
      "name": "obs-001-structured-api-logging",
      "includes": [
        "apps/web/src/app/api/auth/login/route.ts",
        "apps/web/src/app/api/auth/password-reset/route.ts",
        "apps/web/src/app/api/products/[id]/builds/route.ts",
        "apps/web/src/app/api/reports/route.ts",
        "apps/web/src/app/api/servers/directory/route.ts",
        "apps/web/src/app/api/health/route.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "name": "structured-auth-notification-api-logging",
      "includes": [
        "apps/web/src/app/api/auth/**",
        "apps/web/src/app/api/notifications/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ]
}
