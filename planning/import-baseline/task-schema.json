{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MTA NEXUS development task specification v1",
  "type": "object",
  "required": [
    "schema_version",
    "package_status",
    "baseline_sha",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_status": {
      "const": "review_draft"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "track",
          "phase",
          "decision_status",
          "queue_state",
          "priority",
          "source_ids",
          "current",
          "goal",
          "scope_files",
          "acceptance",
          "verification",
          "dependencies",
          "dependency_notes",
          "permission",
          "evidence",
          "limits",
          "execution_state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(DOC|OPS|FLOW|UX|GROW)-[0-9]{2}$"
          },
          "phase": {
            "enum": [
              "F0",
              "F1",
              "F2",
              "F3",
              "F4",
              "F5",
              "F6"
            ]
          },
          "decision_status": {
            "enum": [
              "existing_goal",
              "accepted_direction",
              "proposal",
              "verification_required"
            ]
          },
          "queue_state": {
            "enum": [
              "specified",
              "needs_decision",
              "external_gate",
              "deferred"
            ]
          },
          "priority": {
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "permission": {
            "enum": [
              "local_development",
              "github_settings",
              "external_live",
              "commercial_activation"
            ]
          },
          "execution_state": {
            "const": "not_started"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "lines"
              ]
            }
          }
        }
      }
    }
  }
}
