# Local development defaults. Production intentionally requires explicit values.
# Required by compose.production.yaml on the VDS.
DOMAIN=
ACME_EMAIL=

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional operator-controlled HTTPS fallbacks for the official MTA master list.
# Comma-separated, at most 3 public FQDN endpoints. The official MTA endpoint
# is always attempted first and all endpoints share one 10-second request budget.
MTA_MASTER_MIRROR_URLS=

# PostgreSQL 18
DATABASE_URL=postgres://nexus:nexus_secret@127.0.0.1:5432/mta_nexus

# Generate a unique value with at least 32 characters for production.
AUTH_SECRET=development-only-secret-change-before-production
# Separate 32+ character secret shared only by the app and trusted reverse proxy.
TRUSTED_PROXY_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The closed beta supports local persistent storage only.
# In production this must be an absolute path on a mounted persistent volume.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Reserved for a future S3 adapter. Selecting STORAGE_PROVIDER=s3 currently fails loudly.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_REGION=us-east-1

# Development can log email. Production configuration requires smtp.
EMAIL_PROVIDER=log
BUILD_SCANNER=disabled
CLAMAV_HOST=
CLAMAV_PORT=3310
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Reserved for the account-recovery mail worker. It is NOT started by the
# current local/production Compose stacks. Use independent random 32-byte
# base64url secrets; never reuse AUTH_SECRET.
ACCOUNT_MAIL_KEY_ID=
ACCOUNT_MAIL_KEY=
# Optional one-key drain window during mail-key rotation. Configure both or neither.
ACCOUNT_MAIL_PREVIOUS_KEY_ID=
ACCOUNT_MAIL_PREVIOUS_KEY=
ACCOUNT_RECOVERY_ABUSE_KEY=
ACCOUNT_MAIL_APP_URL=
ACCOUNT_MAIL_SMTP_HOST=
# implicit_tls defaults to 465; starttls defaults to 587 when port is empty.
ACCOUNT_MAIL_SMTP_MODE=implicit_tls
ACCOUNT_MAIL_SMTP_PORT=
ACCOUNT_MAIL_SMTP_SERVERNAME=
ACCOUNT_MAIL_SMTP_FROM=
# Optional SMTP envelope sender for bounce routing; defaults to ACCOUNT_MAIL_SMTP_FROM.
ACCOUNT_MAIL_SMTP_ENVELOPE_FROM=
# Optional SMTP AUTH. auto prefers PLAIN, then LOGIN, using only mechanisms
# advertised after TLS is established. Configure credentials both or neither.
ACCOUNT_MAIL_SMTP_AUTH_MODE=auto
ACCOUNT_MAIL_SMTP_USERNAME=
ACCOUNT_MAIL_SMTP_PASSWORD=
ACCOUNT_MAIL_SMTP_TIMEOUT_MS=5000
ACCOUNT_MAIL_BATCH_SIZE=10
ACCOUNT_MAIL_POLL_INTERVAL_MS=5000

# Host-only source paths for the optional recovery file-mount overlays.
# These are consumed by Docker Compose; the containers see fixed /run/secrets paths.
NEXUS_ACCOUNT_MAIL_KEY_HOST_FILE=
NEXUS_ACCOUNT_RECOVERY_ABUSE_KEY_HOST_FILE=
NEXUS_ACCOUNT_MAIL_PREVIOUS_KEY_HOST_FILE=
NEXUS_ACCOUNT_MAIL_SMTP_PASSWORD_HOST_FILE=
NEXUS_ACCOUNT_MAIL_SMTP_CA_HOST_FILE=


# Optional Web Push VAPID configuration. Configure all three values together.
# Public key: base64url uncompressed P-256 point (65 bytes, 0x04 prefix).
# Private key: base64url P-256 private scalar (32 bytes). Keep it secret.
# Subject identifies the operator, e.g. mailto:ops@example.com or https://example.com.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Operational queue-alert thresholds for push-worker.
# Alerting is separate from the Docker liveness healthcheck.
WEB_PUSH_QUEUE_ALERT_PENDING_PERCENT=80
WEB_PUSH_QUEUE_ALERT_DUE_JOBS=100
WEB_PUSH_QUEUE_ALERT_OLDEST_AGE_SECONDS=900
